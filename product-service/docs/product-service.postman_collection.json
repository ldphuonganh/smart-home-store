{
  "info": {
    "_postman_id": "632b319e-acd9-4fee-b636-177fc379e537",
    "name": "SmartHome - Product Service (TV2)",
    "description": "Test product-service. Chạy thư mục 1 → 5 theo thứ tự bằng Collection Runner. Token ADMIN/CUSTOMER tự sinh từ jwtSecret (không cần auth-service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Tự sinh JWT HS256 cho ADMIN và CUSTOMER bằng secret dùng chung,",
          "// để test product-service độc lập, không cần chạy auth-service.",
          "function b64url(wordArray) {",
          "  return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "}",
          "function makeToken(role) {",
          "  const header = { alg: 'HS256', typ: 'JWT' };",
          "  const now = Math.floor(Date.now() / 1000);",
          "  const payload = { sub: role.toLowerCase() + '@smarthome.vn', userId: role === 'ADMIN' ? 1 : 2,",
          "    email: role.toLowerCase() + '@smarthome.vn', role: role, iat: now, exp: now + 3600 };",
          "  const h = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "  const p = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "  const s = b64url(CryptoJS.HmacSHA256(h + '.' + p, pm.collectionVariables.get('jwtSecret')));",
          "  return h + '.' + p + '.' + s;",
          "}",
          "pm.collectionVariables.set('adminToken', makeToken('ADMIN'));",
          "pm.collectionVariables.set('customerToken', makeToken('CUSTOMER'));"
        ]
      }
    }
  ],
